{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/codebase-investigate/scripts/check-dependencies.js\" \"$TOOL_INPUT\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/codebase-investigate/scripts/check-knowledge-write.js\" \"$TOOL_INPUT\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Grep",
        "hooks": [{
          "type": "command",
          "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/codebase-investigate/scripts/track-investigation.js\" \"$TOOL_INPUT\""
        }]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/codebase-investigate/scripts/validate-output.js\" \"$TOOL_INPUT\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/codebase-investigate/scripts/cleanup-knowledge-confirm.js\" \"$TOOL_INPUT\""
          }
        ]
      }
    ]
  }
}
