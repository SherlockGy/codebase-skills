{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "tool == 'Read' || tool == 'Grep'",
        "hooks": [{
          "type": "command",
          "command": "node \"$PLUGIN_DIR/skills/codebase-investigate/scripts/track-investigation.js\" \"$TOOL_INPUT\""
        }]
      },
      {
        "matcher": "tool == 'Write' && tool_input.file_path matches 'investigation/.*-report\\.md'",
        "hooks": [{
          "type": "command",
          "command": "node \"$PLUGIN_DIR/skills/codebase-investigate/scripts/validate-output.js\" \"$TOOL_INPUT_FILE_PATH\""
        }]
      }
    ]
  }
}
